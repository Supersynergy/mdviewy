<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="mdviewy" android:icon="@drawable/icon" android:allowBackup="false" android:theme="@style/ReadingTheme">
        <activity android:name=".EditorActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="text/markdown"/>
                <data android:mimeType="text/x-markdown"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
