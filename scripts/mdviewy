#!/bin/sh
# mdviewy CLI — open files/folders in mdviewy.app.
#
# Install:  ln -sf "$(pwd)/scripts/mdviewy" /usr/local/bin/mdviewy
#
# Usage:
#   mdviewy <path> [more paths...]   open files or a folder workspace
#   mdviewy .                        open current folder as workspace
#   mdviewy mdviewy://open?path=/x   open via deep link
#
# Prefers launching the app binary directly so argv paths reach the app even
# when LaunchServices would swallow them; falls back to `open -a`.
set -eu

APP=/Applications/mdviewy.app
BIN="$APP/Contents/MacOS/mdviewy"

if [ $# -eq 0 ]; then
  echo "usage: mdviewy <path|mdviewy://url> [...]" >&2
  exit 2
fi

# Resolve relative paths now — the app process may start with a different cwd.
# Rotate "$@": shift each original off the front, append its resolved form to
# the back — paths with spaces stay intact.
input_args="$#"
while [ "$input_args" -gt 0 ]; do
  input_args=$((input_args - 1))
  a=$1
  shift
  case "$a" in
    -*)
      echo "mdviewy: ignoring flag '$a'" >&2
      ;;
    mdviewy://*|file://*|/*)
      set -- "$@" "$a"
      ;;
    *)
      dir=$(dirname "$a")
      if [ -d "$dir" ]; then
        set -- "$@" "$(cd "$dir" && pwd)/$(basename "$a")"
      else
        # Directory part missing — pass through so the app reports the real
        # path in its own not-found handling.
        set -- "$@" "$a"
      fi
      ;;
  esac
done

if [ $# -eq 0 ]; then
  exit 0
fi

if [ -x "$BIN" ]; then
  for a in "$@"; do
    "$BIN" "$a" &
  done
  wait
elif [ -d "$APP" ]; then
  for a in "$@"; do
    open -a mdviewy "$a"
  done
else
  echo "mdviewy: app not found at $APP" >&2
  exit 1
fi
